# Copy to .env in this same directory (woodpecker/.env), fill in the Gitea
# OAuth2 values, then `docker compose up -d`.
#
# Get these by registering a new OAuth2 application in Gitea:
# Site Administration -> Integrations -> OAuth2 Applications -> Create,
# redirect URI: https://woodpecker.josephbernal.com/authorize
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# Shared secret between woodpecker-server and woodpecker-agent -- doesn't
# need to match anything external, just needs to be the same value in both.
WOODPECKER_AGENT_SECRET=
