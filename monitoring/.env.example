GRAFANA_ADMIN_PASSWORD=changeme_generate_a_real_random_value

# Wazuh OpenSearch/Elasticsearch indexer connection (see
# grafana-provisioning/datasources/wazuh.yml). Wazuh runs on Powerstation as a
# separate Hyper-V VM, not in this repo's compose stack -- fill these in with
# its real reachable address and credentials before the datasource will connect.
WAZUH_INDEXER_URL=https://CHANGE_ME:9200
WAZUH_INDEXER_USER=changeme_wazuh_user
WAZUH_INDEXER_PASSWORD=changeme_generate_a_real_random_value
